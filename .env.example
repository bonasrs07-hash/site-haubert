# =============================================================================
# CASA + HAUBERT, variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# =============================================================================

# ---- Público (VAI PARA O BUNDLE DO BROWSER) ---------------------------------
# O prefixo PUBLIC_ significa exatamente isso: é público. Não existe
# "PUBLIC_ mas secreto".
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Número de WhatsApp da reserva, formato E.164. Ver ADR-005 e BLK-005.
#
# Em branco, o CTA degrada para o Instagram da marca ativa, que FUNCIONA.
# Um número fictício degrada para uma conversa que nao existe, que e pior.
# Por isso o placeholder abaixo usa DDD 00, que nao existe no Brasil e
# portanto nao pode ser de ninguem: ele serve para desenvolver e testar o
# fluxo, NUNCA para producao.
PUBLIC_WHATSAPP=+5500000000000

# Slug da casa servida por este deploy (multi-tenant, ADR-002)
PUBLIC_VENUE_SLUG=casa-haubert

# URL canônica (OG tags, canônica, sitemap). OPCIONAL, deixe em branco e o
# astro.config resolve sozinho: domínio de produção da Vercel em produção,
# URL do preview em branch, localhost no seu terminal. Preencha SÓ quando o
# domínio próprio existir (BLK-006), e aí só no ambiente de produção.
PUBLIC_SITE_URL=

# ---- Servidor (NUNCA VAI PARA O BROWSER) ------------------------------------
# Sem prefixo PUBLIC_. Só em endpoint Astro ou Edge Function.
# Se esta chave aparecer no bundle, é incidente de segurança: rotacionar.
SUPABASE_SERVICE_ROLE_KEY=

# Gatilho de rebuild do painel de fotos. (ADR-008)
# Criado em: Vercel > Projeto > Settings > Git > Deploy Hooks.
# É uma URL que, ao receber um POST, publica o site. Quem tiver esta URL
# consegue disparar builds, por isso ela é variável de SERVIDOR, sem
# PUBLIC_, e nunca aparece no bundle nem na tela do painel.
# Em branco, o painel continua funcionando: ele apenas avisa que a publicação
# automática não está configurada, em vez de fingir que publicou.
VERCEL_DEPLOY_HOOK_URL=

# E-mail transacional, só a partir da Fase 3
RESEND_API_KEY=
