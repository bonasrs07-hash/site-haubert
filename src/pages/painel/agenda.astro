---
/**
 * A agenda, editável pelo dono.
 *
 * Fecha o problema nº4 da `docs/00_VISAO`: "quem quer saber o line-up do
 * sábado depende de story que expira em 24h". BLK-007 adiou datas porque data
 * errada queima mais confiança que a ausência dela — e o que destravou não foi
 * mudar de ideia, foi existir onde corrigir em trinta segundos.
 */
import Painel from '@/layouts/Painel.astro';
import EditorDaAgenda from '@/components/painel/EditorDaAgenda';
import { listarAgenda } from '@/lib/agenda';
import { buscarMarcas } from '@/lib/casa';

export const prerender = false;

const sessao = Astro.locals.sessao;
const eventos = await listarAgenda(sessao.supabase, sessao.casaId);
const marcas = (await buscarMarcas()).map((m) => ({ slug: m.slug, nomeCurto: m.nomeCurto }));
---

<Painel titulo="Agenda" email={sessao.email}>
  <EditorDaAgenda client:load eventos={eventos} marcas={marcas} />
</Painel>
