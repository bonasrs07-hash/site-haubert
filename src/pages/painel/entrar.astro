---
/**
 * A porta do painel.
 *
 * Formulário HTML puro: sem ilha, sem `fetch`, sem estado. É a única tela do
 * painel que funciona com o JavaScript desligado, e isso não é purismo, é a
 * tela cujo travamento deixaria o dono do lado de fora da própria casa.
 *
 * Não existe "criar conta" nem "esqueci a senha" aqui, e a ausência é a
 * funcionalidade: o painel tem um login só. (ADR-008)
 */
import Painel from '@/layouts/Painel.astro';
import { lerSessao } from '@/lib/sessao';

export const prerender = false;

// Já logado não vê tela de login.
if (await lerSessao(Astro.cookies)) return Astro.redirect('/painel', 302);

// O erro chega pela URL porque o POST redireciona de volta para cá. Vem de
// `entrar.ts`, que devolve sempre a MESMA frase para qualquer recusa, se
// daqui saísse "e-mail não cadastrado", o formulário viraria um verificador
// de quais e-mails existem.
const erro = Astro.url.searchParams.get('erro');
---

<Painel titulo="Entrar">
  <div class="entrada">
    <div class="entrada__caixa">
      <p class="t-eyebrow">Acesso restrito</p>
      <h1 class="entrada__titulo">Entrar no painel</h1>
      <p class="entrada__lead">
        Aqui é onde as fotos do site são trocadas. Se você chegou por engano,{' '}
        <a class="link" href="/">volte para o site</a>.
      </p>

      {
        erro && (
          <p class="entrada__erro" role="alert">
            {erro}
          </p>
        )
      }

      <form class="entrada__form" method="POST" action="/api/painel/entrar">
        <label class="entrada__campo">
          <span class="t-eyebrow">E-mail</span>
          <input
            type="email"
            name="email"
            autocomplete="username"
            required
            autofocus
            inputmode="email"
          />
        </label>

        <label class="entrada__campo">
          <span class="t-eyebrow">Senha</span>
          <input type="password" name="senha" autocomplete="current-password" required />
        </label>

        <button class="btn btn-primario entrada__enviar" type="submit">Entrar</button>
      </form>
    </div>
  </div>
</Painel>

<style>
  .entrada {
    display: grid;
    place-items: center;
    padding: var(--esp-8) var(--gutter);
    min-height: 70svh;
  }

  .entrada__caixa {
    width: 100%;
    max-width: 26rem;
    display: grid;
    gap: var(--esp-3);
    padding: clamp(var(--esp-5), 6vw, var(--esp-7));
    border: var(--borda-fina) solid var(--cor-borda);
    border-radius: var(--raio-1);
    background-color: var(--cor-superficie-2);
  }

  .entrada__titulo {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--cor-texto-forte);
  }

  .entrada__lead {
    margin: 0 0 var(--esp-2);
    font-size: var(--tam-corpo-sm);
    line-height: 1.55;
    color: var(--cor-texto-suave);
  }

  .entrada__erro {
    margin: 0;
    padding: var(--esp-3) var(--esp-4);
    border-left: 2px solid var(--cor-acento);
    background-color: var(--cor-superficie);
    font-size: var(--tam-corpo-sm);
    color: var(--cor-texto);
  }

  .entrada__form {
    display: grid;
    gap: var(--esp-4);
  }

  .entrada__campo {
    display: grid;
    gap: var(--esp-2);
  }

  .entrada__campo input {
    min-height: var(--alvo-toque);
    padding-inline: var(--esp-3);
    border: var(--borda-fina) solid var(--cor-borda);
    border-radius: var(--raio-1);
    background-color: var(--cor-superficie);
    color: var(--cor-texto);
    font-family: var(--fonte-corpo);
    font-size: 1rem;
  }

  .entrada__campo input:focus-visible {
    outline: 2px solid var(--cor-acento);
    outline-offset: 2px;
  }

  .entrada__enviar {
    width: 100%;
    margin-top: var(--esp-2);
  }
</style>
