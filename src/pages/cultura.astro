---
/**
 * /cultura, música, arte, cidade e os encontros da casa.
 *
 * É a página que sustenta a promessa de "comunidade" com programação concreta
 * em vez de adjetivo. Sem datas até a Fase 2, ver o comentário em Cultura.astro.
 */
import Base from '@/layouts/Base.astro';
import HeroPagina from '@/components/secoes/HeroPagina.astro';
import Faixa from '@/components/secoes/Faixa.astro';
import Cultura from '@/components/secoes/Cultura.astro';
import ChamadaReserva from '@/components/secoes/ChamadaReserva.astro';
import BandaFoto from '@/components/secoes/BandaFoto.astro';
import { FRASE_LOCAL } from '@/constants/casa';

const fotoDoNeon = await buscarFoto('neon');
import { buscarFoto } from '@/lib/fotos';
---

<Base
  titulo="Cultura"
  descricao="In The Flow, Resenha, Bons Tempos e Matcha Club. Música, arte e cidade na CASA + HAUBERT, em Novo Hamburgo."
>
  <HeroPagina
    olho="Programação"
    titulo="A cultura não é acessório"
    lead="Fortalecemos a cena local porque é dela que a casa vive. Música, arte, esporte, moda, e tudo que move a cidade."
    frase={FRASE_LOCAL}
  />

  <Cultura />

  <BandaFoto
    foto={fotoDoNeon}
    frase={FRASE_LOCAL}
    apoio="O neon do salão diz a mesma coisa em inglês desde o primeiro dia. Cena local é fornecedor, artista, produtor e vizinho, quem sustenta a casa nas terças de março, não só nos sábados cheios."
  />

  <Faixa texto="A casa conecta. A memória fica." velocidade={42} />

  <ChamadaReserva
    olho="Presença"
    titulo="Guarde sua mesa para a próxima."
    origem="cultura"
    id="cultura"
  />
</Base>
