---
/**
 * Casca do painel.
 *
 * Não reusa o `Base.astro` de propósito: ali moram a barra de reserva fixa, o
 * rodapé-manifesto, o schema.org das duas marcas e o alternador Dia/Noite,
 * tudo desenhado para converter visitante em mesa. O painel não converte
 * ninguém; ele é ferramenta de trabalho de uma pessoa só.
 *
 * O que ele HERDA são os tokens: a ferramenta é da mesma casa que o site, e
 * cor literal aqui seria bug de white-label igual a cor literal lá.
 * (memory/restrictions.md, ADR-002)
 */
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/bebas-neue/latin-400.css';
import '@/styles/global.css';

import AlternadorModo from '@/components/shared/AlternadorModo.astro';

interface Props {
  titulo: string;
  /** Quem está logado. Ausente na tela de entrar. */
  email?: string;
}

const { titulo, email } = Astro.props;

// A navegação do painel. Cresce por dado, não por `if` espalhado em página.
const SECOES = [
  { href: '/painel', rotulo: 'Fotos' },
  { href: '/painel/reservas', rotulo: 'Reservas' },
  { href: '/painel/cardapio', rotulo: 'Cardápio' },
  { href: '/painel/casa', rotulo: 'A casa' },
];
const rotaAtual = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="pt-BR" data-modo="dia">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Painel</title>
    {/* O painel não é conteúdo. Nunca indexar. */}
    <meta name="robots" content="noindex, nofollow" />

    {/*
      Mesmo script anti-FOUC do site (ADR-004), pela mesma razão: o painel
      também é pintado antes de qualquer JS, e sem isto ele nasceria claro e
      viraria escuro na frente do dono. A chave de armazenamento é a MESMA do
      site — quem trabalha à noite abre as duas coisas no mesmo modo.
    */}
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        var modo = null;
        try {
          var salvo = window.localStorage.getItem('casa-modo');
          if (salvo === 'dia' || salvo === 'noite') modo = salvo;
        } catch (e) {}
        if (!modo) {
          var agora = new Date();
          var minutos = agora.getHours() * 60 + agora.getMinutes();
          modo = minutos >= 1140 || minutos < 300 ? 'noite' : 'dia';
        }
        raiz.setAttribute('data-modo', modo);
      })();
    </script>
  </head>

  <body class="painel">
    <header class="painel__topo">
      <a class="painel__marca" href="/painel">
        Painel <span>da casa</span>
      </a>

      {
        email && (
          <div class="painel__conta">
            {/*
              A troca Dia/Noite aqui é PRÉVIA, não publicação: ela muda como
              VOCÊ está vendo, para dar para julgar uma foto da noite no escuro
              em que ela vai aparecer. O que o visitante vê continua sendo
              decidido pela hora. Daí o rótulo, sem ele o botão sugeriria que
              está trocando o modo do site.
            */}
            <div class="painel__modo">
              <span class="painel__modo-rotulo">Ver como</span>
              <AlternadorModo compacto />
            </div>
            <span class="painel__email">{email}</span>
            <a class="painel__ver" href="/" target="_blank" rel="noopener">
              Ver o site
            </a>
            <form method="POST" action="/api/painel/sair">
              <button class="painel__sair" type="submit">Sair</button>
            </form>
          </div>
        )
      }
    </header>

    {
      email && (
        <nav class="painel__nav" aria-label="Seções do painel">
          {SECOES.map((s) => (
            <a
              class="painel__nav-link"
              href={s.href}
              aria-current={rotaAtual === s.href ? 'page' : undefined}
            >
              {s.rotulo}
            </a>
          ))}
        </nav>
      )
    }

    <main class="painel__corpo">
      <slot />
    </main>
  </body>
</html>

<style>
  .painel {
    /* O corpo do site reserva espaço para a barra de reserva fixa, que aqui
       não existe. Sem isto sobrariam 73px de vazio no fim de toda tela. */
    padding-bottom: 0;
    background-color: var(--cor-superficie);
    min-height: 100svh;
  }

  .painel__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-4);
    padding: var(--esp-4) var(--gutter);
    border-bottom: var(--borda-fina) solid var(--cor-borda);
    background-color: var(--cor-superficie);
  }

  .painel__marca {
    font-family: var(--fonte-titulo);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cor-texto-forte);
    min-height: var(--alvo-toque);
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
  }

  .painel__marca span {
    color: var(--cor-texto-suave);
  }

  .painel__conta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-3) var(--esp-4);
  }

  .painel__modo {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
  }

  .painel__modo-rotulo {
    font-family: var(--fonte-mono);
    font-size: 0.625rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--cor-texto-suave);
  }

  .painel__email,
  .painel__ver,
  .painel__sair {
    font-family: var(--fonte-mono);
    font-size: var(--tam-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--cor-texto-suave);
  }

  .painel__ver,
  .painel__sair {
    display: inline-flex;
    align-items: center;
    min-height: var(--alvo-toque);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
    border-bottom: 1px solid var(--cor-borda);
  }

  .painel__ver:hover,
  .painel__sair:hover {
    color: var(--cor-texto-forte);
    border-bottom-color: var(--cor-acento);
  }

  /* O painel troca de paleta junto com o site, então a transição precisa ser
     a mesma — sem isto o cromo saltaria e o conteúdo deslizaria. */
  .painel {
    transition:
      background-color var(--transicao-modo),
      color var(--transicao-modo);
  }

  /* ---- Navegação entre seções ------------------------------------------ */
  .painel__nav {
    display: flex;
    gap: var(--esp-2);
    overflow-x: auto;
    scrollbar-width: none;
    padding-inline: var(--gutter);
    border-bottom: var(--borda-fina) solid var(--cor-borda);
    background-color: var(--cor-superficie);
  }

  .painel__nav::-webkit-scrollbar {
    display: none;
  }

  .painel__nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--alvo-toque);
    padding-inline: var(--esp-4);
    border-bottom: 2px solid transparent;
    font-family: var(--fonte-mono);
    font-size: var(--tam-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--cor-texto-suave);
    transition:
      color var(--transicao),
      border-color var(--transicao);
  }

  .painel__nav-link:hover {
    color: var(--cor-texto-forte);
  }

  .painel__nav-link[aria-current='page'] {
    color: var(--cor-texto-forte);
    border-bottom-color: var(--cor-acento);
  }

  /* No celular o cabecalho passou a empilhar em tres fileiras e comia 265px
     antes do primeiro cartao. O e-mail sai: com UM login so, ele confirma
     algo que o dono ja sabe, e nao e um controle. Os controles ficam. */
  @media (max-width: 34rem) {
    .painel__topo {
      padding: var(--esp-3) var(--gutter);
      gap: var(--esp-3);
    }

    .painel__email {
      display: none;
    }

    .painel__conta {
      gap: var(--esp-3);
    }
  }

  .painel__corpo {
    /* O padding-top do main global existe por causa do cabeçalho fixo do site.
       Aqui o cabeçalho rola junto. */
    padding-top: 0;
    padding-bottom: var(--esp-9);
  }
</style>
