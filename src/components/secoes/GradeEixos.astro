---
/**
 * Grade de eixos — pilares, entregas, experiências, cultura.
 *
 * Uma estrutura só para quatro conteúdos diferentes: a diferença entre eles é
 * dado, não componente. É o mesmo motivo pelo qual a marca vem de `constants/`
 * e não de um `if`. (P-003)
 */
import type { Pilar } from '@/lib/tipos';

interface Props {
  itens: Pilar[];
  numerado?: boolean;
  colunas?: 2 | 3;
}

const { itens, numerado = false, colunas = 3 } = Astro.props;
---

<ul class:list={['eixos', `eixos--${colunas}`]} role="list">
  {
    itens.map((item, i) => (
      <li class="eixos__item revelar" style={`--atraso:${Math.min(i, 5) * 70}ms`}>
        {numerado && (
          <span class="eixos__num t-meta" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        <h3 class="t-h3 eixos__nome">{item.nome}</h3>
        <p class="eixos__desc">{item.descricao}</p>
      </li>
    ))
  }
</ul>

<style>
  .eixos {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--borda-fina) solid var(--cor-borda);
  }

  .eixos__item {
    display: grid;
    gap: var(--esp-3);
    align-content: start;
    padding-block: var(--esp-6);
    border-bottom: var(--borda-fina) solid var(--cor-borda);
    transition-delay: var(--atraso);
  }

  .eixos__num {
    color: var(--cor-acento);
  }

  .eixos__nome {
    max-width: 16ch;
  }

  .eixos__desc {
    margin: 0;
    max-width: 34ch;
    font-size: var(--tam-corpo-sm);
    line-height: 1.55;
    color: var(--cor-texto-suave);
  }

  @media (min-width: 40rem) {
    .eixos {
      column-gap: var(--esp-6);
    }

    .eixos--2,
    .eixos--3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .eixos--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
