---
/**
 * A tira de atmosfera.
 *
 * Seis cenas na ordem do dia: café, prato, música, brasa, brinde, fogo. É o
 * argumento da casa em imagem, "do primeiro café ao último brinde" deixa de
 * ser frase e vira sequência que se lê em dois segundos.
 *
 * No celular ela rola na horizontal em vez de virar uma pilha de seis fotos:
 * pilha empurraria a reserva para fora do alcance do polegar, e o CTA
 * persistente é o princípio nº 1. Rolagem lateral custa uma tela, não seis.
 */
import Foto from '@/components/shared/Foto.astro';
import { buscarFotos } from '@/lib/fotos';

interface Props {
  legenda?: string;
}

const { legenda = 'Do primeiro café ao último brinde' } = Astro.props;

const tira = await buscarFotos(['tira-1', 'tira-2', 'tira-3', 'tira-4', 'tira-5', 'tira-6']);
---

<section class="tira" aria-label="Atmosfera da casa">
  <div class="casa-container">
    <p class="t-eyebrow tira__olho">
      <span class="tira__traco" aria-hidden="true"></span>
      {legenda}
    </p>
  </div>

  <ul class="tira__rolo revelar" role="list">
    {
      tira.map((foto) => (
        <li class="tira__item">
          <Foto foto={foto} proporcao="3 / 4" larguras={[200, 280, 400]} sizes="(min-width: 64rem) 15vw, 60vw" />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .tira {
    padding-block: var(--esp-8);
    border-top: var(--borda-fina) solid var(--cor-borda);
  }

  .tira__olho {
    display: flex;
    align-items: center;
    gap: var(--esp-3);
    margin: 0 0 var(--esp-5);
  }

  .tira__traco {
    display: block;
    width: var(--esp-6);
    height: 1px;
    background-color: var(--cor-acento);
  }

  .tira__rolo {
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 58vw;
    gap: var(--esp-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Sem a barra visível a tira fica mais limpa e o snap já entrega a dica
       de que há mais coisa à direita. */
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .tira__rolo::-webkit-scrollbar {
    display: none;
  }

  .tira__item {
    scroll-snap-align: start;
  }

  @media (min-width: 48rem) {
    .tira__rolo {
      grid-auto-columns: 30vw;
    }
  }

  /* A partir daqui cabem as seis de uma vez: vira grade e a rolagem some. */
  @media (min-width: 64rem) {
    .tira__rolo {
      grid-auto-flow: row;
      grid-template-columns: repeat(6, 1fr);
      grid-auto-columns: auto;
      gap: var(--esp-3);
      overflow-x: visible;
      max-width: var(--largura-max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }
  }
</style>
